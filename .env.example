# Copy this file to server/.env (or .env at the repo root for Docker).
# The server adapts to whatever you set here - see "Storage" below.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Authentication (required) ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it the server generates a throwaway secret in development and refuses
# to start when NODE_ENV=production.
JWT_SECRET=

# How long a sign-in lasts (15m, 12h, 7d, 30d).
JWT_EXPIRES_IN=7d

# bcrypt cost factor. Higher is slower and safer.
BCRYPT_ROUNDS=12

# Set to false after creating your account to close public sign-ups.
# The very first account is always allowed so you can never lock yourself out.
ALLOW_REGISTRATION=true

# --- Storage ---
# Leave DATABASE_URL empty to use SQLite (a VPS, Docker, local development).
# Set it to a Postgres connection string and the server switches drivers
# automatically - required on any host without a persistent disk (Vercel,
# Render free, Railway). Neon and Supabase both have permanent free tiers.
# DATABASE_URL=postgres://user:password@host/dbname
# PGSSL=disable          # only for a local Postgres without TLS

# Where SQLite keeps its file. Ignored when DATABASE_URL is set.
DB_PATH=./database/sendtowp.db

# Where the WhatsApp session lives.
#   file      a directory on disk (default when a disk is available)
#   database  rows in the database (default when running serverless)
# Losing this means scanning the pairing QR again.
# AUTH_STORE=file
# WHATSAPP_AUTH_PATH=./whatsapp-auth

# --- Scheduling ---
# Attempts before a message is left in the Failed state.
RETRY_LIMIT=3

# persistent  in-process cron runs every minute and the socket stays open
# serverless  no in-process cron; POST /api/cron/run drives sending instead
# Detected automatically; only set this to override.
# RUNTIME_MODE=persistent

# Required to use POST /api/cron/run. Generate one the same way as JWT_SECRET.
# Vercel Cron sends it automatically as a bearer token; other pingers can use
# /api/cron/run?secret=...
# CRON_SECRET=

# How long to wait for WhatsApp to connect before a send gives up (serverless).
# WA_CONNECT_TIMEOUT_MS=30000

# --- Keeping free tiers awake ---
# How often the app writes a heartbeat row. This is what stops Supabase from
# pausing a free project after 7 days of "inactivity". Default 6 hours.
# Do NOT lower this on Neon: its compute auto-suspends when idle and that is how
# it stays inside the free 100 CU-hour allowance.
# HEARTBEAT_INTERVAL_MS=21600000

# Delete one-off messages this many days after they were sent, so a 0.5 GB free
# database cannot slowly fill up. Recurring messages are never removed.
# Set to 0 to keep everything forever.
MESSAGE_RETENTION_DAYS=90

# A free web service that sleeps (Render) can only be woken from outside.
# Point an uptime pinger at GET /api/keepalive every ~10 minutes.
# See .github/workflows/keepalive.yml, or use cron-job.org.

# --- Networking ---
# Comma separated origins allowed to call the API from a browser.
# Leave empty when the server also serves the built client (single origin).
CLIENT_ORIGIN=http://localhost:5173

# Requests allowed per IP per 15 minutes across /api.
RATE_LIMIT=1200

# Set when running behind a reverse proxy so rate limiting sees the real client
# IP. Automatically enabled on serverless hosts. Example: 1
# TRUST_PROXY=1
