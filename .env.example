# Copy this file to server/.env and adjust the values.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Authentication (required) ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it the server generates a throwaway secret in development and refuses
# to start when NODE_ENV=production.
JWT_SECRET=

# How long a sign-in lasts (zeit/ms format: 15m, 12h, 7d, 30d).
JWT_EXPIRES_IN=7d

# bcrypt cost factor. Higher is slower and safer.
BCRYPT_ROUNDS=12

# Set to false after creating your account to close public sign-ups.
# The very first account is always allowed so you can never lock yourself out.
ALLOW_REGISTRATION=true

# --- Storage ---
# Both of these must live on persistent storage. Losing the auth folder means
# scanning the pairing QR again. In Docker they default to /data/...
DB_PATH=./database/sendtowp.db
# WHATSAPP_AUTH_PATH=./whatsapp-auth

# --- Scheduler ---
# Attempts before a message is left in the Failed state.
RETRY_LIMIT=3

# --- Networking ---
# Comma separated origins allowed to call the API from a browser.
# Leave empty when the server also serves the built client (single origin).
CLIENT_ORIGIN=http://localhost:5173

# Requests allowed per IP per 15 minutes across /api.
RATE_LIMIT=1200

# Set when running behind a reverse proxy (nginx, Render, Railway...) so rate
# limiting sees the real client IP. Example: 1
# TRUST_PROXY=1
